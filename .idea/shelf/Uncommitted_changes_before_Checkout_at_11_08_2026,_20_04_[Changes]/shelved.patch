+#!/usr/bin/env python3
+"""Обновляет badge coverage в README.md."""
+
+import re
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+ROOT = Path(__file__).parent.parent
+README = ROOT / "README.md"
+COVERAGE_XML = ROOT / "coverage.xml"
+
+
+def main() -> int:
+    if not COVERAGE_XML.exists():
+        return 0
+
+    root = ET.parse(COVERAGE_XML).getroot()
+    line_rate = float(root.get("line-rate", "0"))
+    percent = int(line_rate * 100)
+
+    # Цвет badge
+    if percent >= 90:
+        color = "brightgreen"
+    elif percent >= 75:
+        color = "green"
+    elif percent >= 50:
+        color = "yellow"
+    else:
+        color = "red"
+
+    badge_url = f"https://img.shields.io/badge/coverage-{percent}%-{color}"
+
+    content = README.read_text(encoding="utf-8")
+    # Заменяем старый badge
+    content = re.sub(
+        r"!\[Coverage\]\(https://img\.shields\.io/badge/coverage-.*?\.svg\)",
+        f"![Coverage]({badge_url})",
+        content,
+    )
+    README.write_text(content, encoding="utf-8")
+    print(f"✅ Updated coverage badge: {percent}%")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
